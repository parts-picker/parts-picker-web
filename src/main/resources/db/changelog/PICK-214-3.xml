                SELECT COUNT(1) FROM projects WHERE org_unit_id IS null
            </sqlCheck>
        </preConditions>

        <addNotNullConstraint tableName="projects" columnName="org_unit_id"
                              constraintName="nnc_projects_org_unit_id"/>
    </changeSet>

    <changeSet id="PICK-214:addForeignKeyConstraintToOrgUnitIdInProjectsTable" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_org_unit_of_project"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="projects"
                baseColumnNames="org_unit_id"
                constraintName="fk_org_unit_of_project"
                referencedTableName="org_units"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>

