                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="PICK-214:insertSystemUser" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM users WHERE issuer = 'urn:parts-picker:system'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="users">
            <column name="id" valueComputed="nextval('user_seq')"/>
            <column name="issuer" value="urn:parts-picker:system"/>
            <column name="subject" value="system"/>
            <column name="username" value="system"/>
            <column name="display_name" value="System"/>
            <column name="type" value="SYSTEM"/>
        </insert>
    </changeSet>

    <changeSet id="PICK-214:insertMigrationBaseOrgUnit" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM org_units ou JOIN users u ON u.id = ou.owner_id
                    WHERE u.issuer = 'urn:parts-picker:system'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="org_units">
            <column name="id" valueComputed="nextval('org_unit_seq')"/>
            <column name="name" value="Migration Base"/>
            <column name="short_description" value="Holds everything that existed before org units"/>
            <column name="owner_id"
                    valueComputed="(SELECT id FROM users WHERE issuer = 'urn:parts-picker:system')"/>
            <column name="created_by"
                    valueComputed="(SELECT id FROM users WHERE issuer = 'urn:parts-picker:system')"/>
            <column name="created_on" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="PICK-214:insertMigrationBaseOrgUnitOwnerEntitlement" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="1">
                    SELECT COUNT(1) FROM org_unit_entitlements oue JOIN users u ON u.id = oue.user_id
                    WHERE u.issuer = 'urn:parts-picker:system'
                </sqlCheck>
            </not>
        </preConditions>

        <insert tableName="org_unit_entitlements">
            <column name="id" valueComputed="nextval('org_unit_entitlement_seq')"/>
            <column name="org_unit_id"
                    valueComputed="(SELECT ou.id FROM org_units ou JOIN users u ON u.id = ou.owner_id WHERE u.issuer = 'urn:parts-picker:system')"/>
            <column name="user_id"
                    valueComputed="(SELECT id FROM users WHERE issuer = 'urn:parts-picker:system')"/>
            <column name="access_level" value="MAINTAIN"/>
            <column name="joined_on" valueComputed="now()"/>
        </insert>
    </changeSet>

    <changeSet id="PICK-214:addOrgUnitIdToProjectsTable" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="projects" columnName="org_unit_id"/>
            </not>
        </preConditions>

        <addColumn tableName="projects">
            <column name="org_unit_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="PICK-214:moveProjectsWithoutOrgUnitIntoMigrationBase" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(1) FROM projects WHERE org_unit_id IS null
                </sqlCheck>
            </not>
        </preConditions>

        <sql>
            UPDATE projects SET org_unit_id = (
            SELECT ou.id FROM org_units ou JOIN users u ON u.id = ou.owner_id
            WHERE u.issuer = 'urn:parts-picker:system'
            ) WHERE org_unit_id IS null;
        </sql>
    </changeSet>

