        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="PICK-214:addCreationInfoToProjectsTable" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="projects" columnName="created_by"/>
            </not>
        </preConditions>

        <addColumn tableName="projects">
            <column name="created_by" type="BIGINT"/>
            <column name="created_on" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <changeSet id="PICK-214:setCreationInfoOfProjectsWithoutIt" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(1) FROM projects WHERE created_by IS null
                </sqlCheck>
            </not>
        </preConditions>

        <sql>
            UPDATE projects SET
            created_by = (SELECT id FROM users WHERE issuer = 'urn:parts-picker:system'),
            created_on = now()
            WHERE created_by IS null;
        </sql>
    </changeSet>

    <changeSet id="PICK-214:addNonNullConstraintToCreatedByColumnInProjectsTable" author="RobinGuth">
        <preConditions>
            <columnExists tableName="projects" columnName="created_by"/>
            <sqlCheck expectedResult="0">
                SELECT COUNT(1) FROM projects WHERE created_by IS null
            </sqlCheck>
        </preConditions>

        <addNotNullConstraint tableName="projects" columnName="created_by"
                              constraintName="nnc_projects_created_by"/>
    </changeSet>

    <changeSet id="PICK-214:addNonNullConstraintToCreatedOnColumnInProjectsTable" author="RobinGuth">
        <preConditions>
