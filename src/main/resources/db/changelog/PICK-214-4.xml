        <addNotNullConstraint tableName="projects" columnName="created_on"
                              constraintName="nnc_projects_created_on"/>
    </changeSet>

    <changeSet id="PICK-214:addForeignKeyConstraintToCreatedByInProjectsTable" author="RobinGuth">
        <preConditions onFail="MARK_RAN">
            <not>
                <foreignKeyConstraintExists foreignKeyName="fk_created_by_of_project"/>
            </not>
        </preConditions>

        <addForeignKeyConstraint
                baseTableName="projects"
                baseColumnNames="created_by"
                constraintName="fk_created_by_of_project"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="RESTRICT"
        />
    </changeSet>

